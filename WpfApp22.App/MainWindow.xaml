<Window x:Class="WpfApp22.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:WpfApp22.App"
        Title="多通道数据采集系统  ·  Multi-Channel SCADA"
        Height="920" Width="1520" MinHeight="520" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Window.Base}">
    <Window.Resources>
        <local:ChannelStateToBrushConverter x:Key="StateBrush" />
        <local:AlarmSeverityToBrushConverter x:Key="SeverityBrush" />
        <local:NotNullToBoolConverter x:Key="NotNull" />
        <local:NonZeroToBoolConverter x:Key="NonZero" />
        <local:AlarmActiveTextConverter x:Key="AlarmActiveText" />
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <!-- DataGridColumn 不在可视化树上、拿不到窗口 DataContext，列的可见性只能借这个代理桥接 -->
        <local:BindingProxy x:Key="Vm" Data="{Binding}" />
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- 标题 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="多通道数据采集系统" Style="{StaticResource Text.Title}" FontSize="16" />
                <TextBlock Text="  多串口 / 多 TCP / 多协议并发采集" Style="{StaticResource Text.Muted}" Margin="12,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="曲线窗口" Style="{StaticResource Text.Muted}" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding ChartWindowSeconds}"
                          Width="110" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0} 秒}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- 工具栏 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Border}" Padding="10,8" Margin="0,0,0,10">
            <WrapPanel>
                <Button Content="全部启动" Style="{StaticResource Button.Primary}"
                        Command="{Binding StartAllCommand}" />
                <Button Content="全部停止" Style="{StaticResource Button.Danger}"
                        Command="{Binding StopAllCommand}" />
                <Button Content="新增通道" Command="{Binding AddChannelCommand}" />
                <Button Content="编辑通道" Command="{Binding EditChannelCommand}"
                        IsEnabled="{Binding SelectedChannel, Converter={StaticResource NotNull}}" />
                <Button Content="删除通道" Command="{Binding RemoveChannelCommand}"
                        IsEnabled="{Binding SelectedChannel, Converter={StaticResource NotNull}}" />
                <Button Content="导出 CSV" Command="{Binding ExportCommand}" CommandParameter="csv"
                        Margin="16,0,8,0" />
                <Button Content="导出 Excel" Command="{Binding ExportCommand}" CommandParameter="excel" />
                <Button Content="清屏" Command="{Binding ClearDataCommand}" Margin="16,0,8,0" />
                <Button Content="{Binding FaultButtonText}" Command="{Binding InjectFaultCommand}" />
                <Button Content="确认报警" Command="{Binding AcknowledgeAllCommand}"
                        IsEnabled="{Binding UnackedAlarmCount, Converter={StaticResource NonZero}}" />
            </WrapPanel>
        </Border>

        <!-- 状态栏：DockPanel 优先满足 Dock 元素，所以屏幕再矮它也不会被上方内容顶出可视区 -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,6" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="总吞吐 " Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding TotalRateHz, StringFormat={}{0:F1}}" FontWeight="SemiBold" />
                    <TextBlock Text=" 点/秒" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="   累计 " Style="{StaticResource Text.Muted}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding TotalSamples}" FontWeight="SemiBold" />
                    <TextBlock Text="   丢弃 " Style="{StaticResource Text.Muted}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding DroppedSamples}" Foreground="#FFD29922" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Text.Muted}"
                           Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding ConfigPath}" Style="{StaticResource Text.Muted}" />
            </Grid>
        </Border>

        <!-- 剩余空间按 3:1 分给主区与报警区 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="160" />
                <RowDefinition Height="*" MinHeight="100" />
            </Grid.RowDefinitions>

            <!-- 主区 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560" MinWidth="380" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：通道与点位。小屏工控机上用标签页切换，避免两块表格互相挤压 -->
            <Border Grid.Column="0" Style="{StaticResource Panel.Border}">
                <TabControl>
                    <TabItem Header="采集通道">
                        <DataGrid Margin="6" ItemsSource="{Binding Channels}"
                                  SelectedItem="{Binding SelectedChannel}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="状态" Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="9" Height="9"
                                                     Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="通道" Binding="{Binding Name}" Width="*" MinWidth="104" />
                                <DataGridTextColumn Header="链路" Binding="{Binding Endpoint}" Width="102" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="60" />
                                <DataGridTextColumn Header="点/秒" Binding="{Binding RateHz, StringFormat={}{0:F1}}" Width="56" />
                                <DataGridTemplateColumn Header="操作" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding ToggleText}" Padding="8,2" Margin="0" FontSize="11"
                                                    Command="{Binding DataContext.ToggleChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="点位实时值">
                        <!--
                            先看设备、再看点位：左边是设备列表，选中某台设备后右边只显示它的点位。
                            通道多的时候，一张平铺的全量点位表根本没法盯。
                        -->
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" MinWidth="96" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 设备列表 -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="设备列表" Style="{StaticResource Text.Muted}"
                                           FontSize="11" Margin="2,0,0,5" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding Devices}"
                                         SelectedItem="{Binding SelectedDevice}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 设备名会被截断，完整信息（链路 / 状态 / 点位 / 报警）放在 ToolTip 里 -->
                                            <Grid ToolTip="{Binding ToolTip}" Background="Transparent"
                                                  HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding State, Converter={StaticResource StateBrush}}"
                                                         Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <!-- 右侧数字是点位个数；该设备有活动报警时变红加粗，兼作报警角标 -->
                                                <TextBlock Grid.Column="2" Text="{Binding PointCount}" FontSize="11"
                                                           Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Critical}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- 点位表 -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="搜索" Style="{StaticResource Text.Muted}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" VerticalContentAlignment="Center"
                                             ToolTip="按点位名、地址或通道名过滤"
                                             Text="{Binding PointFilterText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PointFilterSummary}"
                                               Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </Grid>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding Points}">
                                    <DataGrid.Columns>
                                        <!-- 选中具体设备时这一列整列同名，由 VM 折叠掉 -->
                                        <DataGridTextColumn Header="通道" Binding="{Binding ChannelName}"
                                                            Width="*" MinWidth="70"
                                                            Visibility="{Binding Data.ChannelColumnVisibility,
                                                                                 Source={StaticResource Vm}}" />
                                        <DataGridTextColumn Header="点位" Binding="{Binding Name}"
                                                            Width="*" MinWidth="52" />
                                        <DataGridTextColumn Header="功能码·地址" Binding="{Binding AccessText}" Width="76" />
                                        <DataGridTextColumn Header="数值" Binding="{Binding ValueText}" Width="56">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Margin" Value="0,0,8,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="36" />
                                        <DataGridTextColumn Header="限值" Binding="{Binding LimitText}" Width="64" />
                                        <DataGridTextColumn Header="品质" Binding="{Binding StateText}" Width="44" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 右侧：实时曲线 -->
            <Border Grid.Column="2" Style="{StaticResource Panel.Border}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="12,10,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="实时趋势曲线" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{Binding ChartScopeText}" Style="{StaticResource Text.Muted}"
                                       Margin="8,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox Content="只看当前设备" IsChecked="{Binding ChartFollowsFilter}"
                                      Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,14,0"
                                      ToolTip="跟随左侧设备列表的选择，只画选中设备的曲线" />
                            <CheckBox Content="Y 轴自动缩放" IsChecked="{Binding AutoScaleY}"
                                      Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>
                    </Grid>
                    <sp:WpfPlot x:Name="LivePlot" Grid.Row="1" Margin="6,0,6,6" />
                </Grid>
            </Border>
        </Grid>

        <!-- 报警区 -->
        <Border Grid.Row="1" Style="{StaticResource Panel.Border}" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="12,10,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="报警中心" Style="{StaticResource Text.Title}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="12,0,0,0">
                            <Run Text="活动 " />
                            <Run Text="{Binding ActiveAlarmCount}" Foreground="#FFF85149" />
                            <Run Text="  ·  未确认 " />
                            <Run Text="{Binding UnackedAlarmCount}" Foreground="#FFD29922" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding NotifyChannelsText}"
                               Style="{StaticResource Text.Muted}" />
                </Grid>
                <DataGrid Grid.Row="1" Margin="8,0,8,8" ItemsSource="{Binding Alarms}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="级别" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SeverityText}"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="时间" Binding="{Binding RaisedAt, StringFormat={}{0:HH:mm:ss}}" Width="80" />
                        <DataGridTextColumn Header="通道" Binding="{Binding ChannelName}" Width="120" />
                        <DataGridTextColumn Header="点位" Binding="{Binding PointName}" Width="110" />
                        <DataGridTextColumn Header="报警内容" Binding="{Binding Message}" Width="*" />
                        <DataGridTextColumn Header="触发值" Binding="{Binding TriggerValue, StringFormat={}{0:F2}}" Width="80" />
                        <DataGridTextColumn Header="状态" Width="70"
                                            Binding="{Binding IsActive, Converter={StaticResource AlarmActiveText}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        </Grid>
    </DockPanel>
</Window>
